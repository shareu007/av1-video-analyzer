{
  "schemaVersion": "av1scope.ffmpeg-distribution-policy.v1",
  "requiredLibraries": [
    "libavcodec",
    "libavfilter",
    "libavformat",
    "libavutil",
    "libswscale",
    "zlib"
  ],
  "forbiddenConfigureFlags": [
    "--enable-gpl",
    "--enable-version3",
    "--enable-nonfree"
  ],
  "requiredReleaseEvidence": [
    "sourceRevision",
    "sourceArchiveSha256",
    "configureFlags",
    "compilerIdentity",
    "binarySha256",
    "bundleInventory",
    "licenseInventory",
    "sbom",
    "relocatableRpath",
    "runtimeSmoke"
  ],
  "developmentBuildMayBeNonDistributable": true,
  "notes": "This policy is an engineering gate, not legal advice. Release approval still requires license review."
}
